{
  "name": "mobile",
  "main": "expo-router/entry",
  "dependencies": {
    "@flimme/contract": "workspace:*",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.5.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.50",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "tokens": "node scripts/tokens.mjs",
    "check": "node scripts/tokens.mjs --check && node scripts/check-i18n.mjs && node scripts/check-gallery.mjs && eslint . && tsc --noEmit && jest --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.css$": "<rootDir>/jest.style-stub.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/dist/"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}

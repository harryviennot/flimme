# Copied to .env.local by `mise run setup`. EXPO_PUBLIC_ values end up inside the app:
# they are configuration, never secrets.

# Local Supabase. `mise run dev` rewrites the host to the Mac's network address so a
# phone on the same Wi-Fi can reach it.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key

# The recommendation server's HTTP API (Letterboxd upload, account deletion).
EXPO_PUBLIC_SERVER_URL=http://127.0.0.1:8000

# Off locally: development builds send nothing.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

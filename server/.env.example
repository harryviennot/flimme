# Copy to .env.local (git-ignored) and adjust. `uv run server <command>` reads it from this
# folder. In staging and production the host sets real environment variables instead.
# The values below are placeholders, not real credentials. An empty value means "not set".

# local, staging or production
ENVIRONMENT=local

# Each process has its own database login: PIPELINE_DATABASE_URL (pipeline worker, backfill),
# DECK_DATABASE_URL, TRAINER_DATABASE_URL and API_DATABASE_URL. In staging and production set
# the one your process needs, through the shared pooler in session mode. Locally, one
# DATABASE_URL stands in for all of them. For `supabase start` the database listens on port
# 54322 and a seed script creates the login; for the lite database
# (supabase/lite/README.md) use postgresql:///movie_swipe_lite instead.
DATABASE_URL=postgresql://app_server:change-me@127.0.0.1:54322/postgres
PIPELINE_DATABASE_URL=
DECK_DATABASE_URL=
TRAINER_DATABASE_URL=
API_DATABASE_URL=

# The Supabase project's URL (the HTTP API only): it checks tokens against the project's
# signing keys at <url>/auth/v1/.well-known/jwks.json. Locally: http://127.0.0.1:54321, and run
# `supabase gen signing-key` once (see README.md).
SUPABASE_URL=

# TMDB's read access token (pipeline worker and API). Not needed for tests, which replay
# recorded responses.
TMDB_READ_TOKEN=

# Error reports (https://sentry.io). Leave empty locally.
SENTRY_DSN=

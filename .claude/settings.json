{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(mise run *)",
      "Bash(node tools/*)",
      "Bash(node mobile/scripts/*)",
      "Bash(bash supabase/lite/*)",
      "Bash(pnpm install)",
      "Bash(pnpm --filter * run *)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * exec jest *)",
      "Bash(pnpm --filter * exec tsc *)",
      "Bash(pnpm --filter * exec eslint *)",
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(supabase status *)",
      "Bash(supabase start *)",
      "Bash(supabase db reset *)",
      "Bash(supabase test db *)",
      "Bash(supabase migration new *)",
      "Bash(supabase gen types *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Bash(supabase db push *)",
      "Bash(supabase link *)",
      "Bash(fly deploy *)",
      "Bash(flyctl deploy *)",
      "Bash(eas submit *)",
      "Bash(npx eas-cli@latest submit *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
